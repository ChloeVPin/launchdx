#compdef launchdx
# zsh completion for launchdx

_launchdx() {
    local -a commands
    commands=(
        'diagnose:inspect an application, disk image, or installer package and explain the evidence behind a launch blocker'
        'evidence:show raw evidence for an application, disk image, or installer package'
    )

    if (( CURRENT == 2 )); then
        local -a toplevel
        toplevel=(
            'diagnose:inspect an application, disk image, or installer package and explain the evidence behind a launch blocker'
            'evidence:show raw evidence for an application, disk image, or installer package'
            '--version:print the launchdx version'
            '-V:print the launchdx version'
            '--help:show help'
            '-h:show help'
        )
        _describe -t commands 'launchdx' toplevel
        return
    fi

    case "${words[2]}" in
        diagnose | evidence)
            _arguments \
                '*:application artifact:_files -g "*.app(-/)" -g "*.dmg" -g "*.pkg"' \
                '--json[emit a machine readable JSON report]' \
                '--verbose[include suggested repair actions]' \
                '--no-color[disable colored output]' \
                '--help[show help]' \
                '-h[show help]'
            ;;
        *)
            _message 'unknown launchdx command'
            ;;
    esac
}

_launchdx "$@"
